# Copy to .env and fill in. Never commit .env.
# Run with:  node --env-file=.env dist/src/server.js

# Set to "production" when deployed. Production refuses to start without
# RESEND_API_KEY, EMAIL_FROM, and CORS_ORIGIN.
NODE_ENV=development

PORT=3000
DATABASE_PATH=users.db

# Comma-separated emails that act as administrators.
ADMIN_EMAILS=you@example.com

# Login emails, sent through Resend (https://resend.com).
# EMAIL_FROM must be on a domain you have verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Bake Off Fantasy <login@example.com>"

# Origin(s) of the web app, comma-separated, e.g. https://fantasy.example.com
CORS_ORIGIN=

# Set to "true" only when running behind a reverse proxy you control, so rate
# limits use the client address from X-Forwarded-For.
TRUST_PROXY=false
