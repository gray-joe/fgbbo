{
  "name": "basic-node-api",
  "version": "1.0.0",
  "private": true,
  "description": "A TypeScript CRUD API backed by SQLite",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/src/server.js",
    "seed": "npm run build && node dist/src/seed.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc -p e2e"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
